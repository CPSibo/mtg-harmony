# Cloudflare Pages. Files in /assets have content-hashed names, so a changed
# file gets a new URL: cache them for good instead of revalidating each visit.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker (#169). Browsers check it for updates on each visit; never
# let a cache hold an old one.
/sw.js
  Cache-Control: no-cache
